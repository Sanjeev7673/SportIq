# Set these in Vercel -> Project Settings -> Environment Variables.
# Replace the placeholder with the real backend base URL. Do not commit secrets here.
# VITE_API_URL must include /api/v1 if the frontend API client expects the versioned API root.
VITE_API_URL=https://YOUR-BACKEND-HOST/api/v1
VITE_SERVER_URL=https://YOUR-BACKEND-HOST
